calculate_grade
delimiter //
create procedure grade(in a int,in b varchar(20),in c int)
begin 
if c>=90 and c<=100 then
select a,b,c,'A+';
elseif c>=80 then 
select a,b,c,'A';
elseif c>=70 then
select a,b,c,'b';
elseif c>=60 then 
select a,b,c,'c';
elseif c>= 50 then
select a,b,c,'d';
else 
select 'fail' ;
end if;
end //
delimiter ;

